# LibreLiveTopology Docker Environment Configuration
# Copy this to .env and customize for your setup

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_DATABASE=librenms
DB_USERNAME=librenms
# Generate unique values and provide them through a secret store or local .env.
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_PASSWORD

# LibreNMS Configuration
LIBRENMS_DOCKER=true
LIBRENMS_PATH=/opt/librenms
LIBRENMS_RRD_BASE=/opt/librenms/rrd
TZ=UTC

# LibreLiveTopology Configuration
LIBRELIVETOPOLOGY_LOG_STDOUT=true
LIBRELIVETOPOLOGY_LOG_LEVEL=info
SKIP_CRON=true

# Ports
WEB_PORT=8000

# Performance
MEMCACHED_ENABLED=true
REDIS_ENABLED=true